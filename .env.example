# Google Analytics Measurement ID (e.g. G-XXXXXXXXXX)
# Set locally in .env, and as a GitHub Actions secret for deploys.
VITE_GA_MEASUREMENT_ID=

# CARTO basemap API key, for the trail map in the "Before · plan the day" demo panel.
# CARTO watermarks every tile served without one ("API KEY REQUIRED"), so the map
# renders as a styled panel without a basemap until this is set.
# Free tier: https://carto.com/basemaps
VITE_CARTO_API_KEY=
