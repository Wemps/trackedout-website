# Google Analytics Measurement ID (e.g. G-XXXXXXXXXX). OPTIONAL — an override.
#
# The site's own ID is committed in src/app/analytics.ts, so production reports
# without anything set here. Set this only to point a build at a different
# property.
#
# It doubles as the switch that turns analytics on in `npm run dev`, which is
# otherwise silent so local clicking doesn't land in the real property. Use a
# throwaway ID when testing tagging.
VITE_GA_MEASUREMENT_ID=

# Mapbox public access token (pk.*), for the three maps on the landing page.
#
# NOT A SECRET. Vite inlines every VITE_* variable into the built JS, which is
# served publicly — the Actions secret keeps this out of the repo, not out of the
# bundle. That is normal and correct for a pk.* token. Protect spend with URL
# restrictions and a monthly limit in the Mapbox account instead.
#
# Without it, all three maps fall back to their styled placeholders.
VITE_MAPBOX_TOKEN=
